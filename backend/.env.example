# CS2 Market — backend environment template
# Copy this file to backend/.env for local development.
# Never commit backend/.env or put real tokens in GitHub.
# On Render, set these values in Dashboard -> Environment instead.

# Server
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_FILE=./data/cs2-market.sqlite

# Telegram Bot
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_TELEGRAM_IDS=YOUR_NUMERIC_TELEGRAM_ID
TELEGRAM_WEBHOOK_URL=https://YOUR-SERVICE.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Private Telegram backup channel (numeric channel ID, usually starts with -100)
CHANNEL_ID=-1001234567890

# Private GitHub backup repository
GITHUB_BACKUP_REPO=YOUR_GITHUB_USERNAME/cs2-market-backups
GITHUB_BACKUP_TOKEN=YOUR_GITHUB_FINE_GRAINED_TOKEN
GITHUB_BACKUP_BRANCH=main

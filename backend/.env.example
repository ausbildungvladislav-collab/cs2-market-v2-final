# BotFather token. Never put this token in frontend files.
BOT_TOKEN=123456:REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN
# Optional Telegram Stars webhook.
TELEGRAM_WEBHOOK_URL=https://YOUR-SERVICE.onrender.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Private GitHub backup repository, formatted as owner/repo.
GITHUB_BACKUP_REPO=YOUR-USERNAME/cs2-market-backups
GITHUB_BACKUP_TOKEN=github_pat_REPLACE_WITH_FINE_GRAINED_TOKEN
GITHUB_BACKUP_BRANCH=main
# Comma-separated numeric Telegram IDs allowed to use Admin APIs.
ADMIN_TELEGRAM_IDS=
FRONTEND_ORIGIN=https://YOUR-USERNAME.github.io
PORT=3000
DATABASE_FILE=./data/cs2-market.sqlite